[Unit]
Description=Meridian backend server
Documentation=https://github.com/rmrobinson/meridian
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=meridiand
Group=meridiand
Environment="AWS_CONFIG_FILE=/home/meridiand/.aws/config"
Environment="AWS_SHARED_CREDENTIALS_FILE=/home/meridiand/.aws/credentials"
Environment="AWS_PROFILE=meridian"

WorkingDirectory=/opt/meridiand
ExecStart=/opt/meridiand/meridiand --config /etc/meridiand/config.yaml
Restart=on-failure
RestartSec=5s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: AWS_CONFIG_FILE/AWS_SHARED_CREDENTIALS_FILE live under
# meridiand's own home dir (/home/meridiand/.aws) and must stay readable.
ProtectHome=read-only
ReadWritePaths=/var/lib/meridiand
ReadOnlyPaths=/etc/meridiand /opt/meridiand

[Install]
WantedBy=multi-user.target
